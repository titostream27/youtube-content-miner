{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aelflab.com/contracts/render-request-v2.schema.json",
  "title": "RenderRequestV2",
  "description": "Shared contract between youtube-content-miner (WHAT/WHY) and AI-Youtube-Shorts-Generator (HOW). Phase 1 §5.5 canonical contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "request_id", "episode_id", "video_url", "mode", "source_preferences", "output", "clips"],
  "properties": {
    "contract_version": { "const": "2.0" },
    "request_id": { "type": "string", "minLength": 1 },
    "episode_id": { "type": "string", "minLength": 1 },
    "video_url": { "type": "string", "format": "uri" },
    "mode": { "enum": ["preview", "final"] },
      "force_rerender": { "type": "boolean", "default": false },
    "source_preferences": {
      "type": "object",
      "required": ["max_height", "prefer_best_available"],
      "properties": {
        "max_height": { "type": "integer", "minimum": 0 },
        "prefer_best_available": { "type": "boolean" }
      }
    },
    "output": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "fps": { "type": "integer", "minimum": 1 }
      }
    },
    "clips": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/clip" }
    }
  },
  "definitions": {
    "clip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clip_id", "start_sec", "end_sec", "title", "narrative", "layout_plan", "caption_plan", "editing_events"],
      "properties": {
        "clip_id": { "type": ["string", "integer"] },
        "start_sec": { "type": "number", "minimum": 0 },
        "end_sec": { "type": "number" },
        "title": { "type": "string" },
        "narrative": { "$ref": "#/definitions/narrative" },
        "layout_plan": { "$ref": "#/definitions/layout_plan" },
        "caption_plan": { "$ref": "#/definitions/caption_plan" },
        "editing_events": {
          "type": "array",
          "items": { "$ref": "#/definitions/editing_event" }
        }
      }
    },
    "narrative": {
      "type": "object",
      "required": ["main_topic", "ending_type", "hook_end_sec", "payoff_start_sec"],
      "properties": {
        "main_topic": { "type": "string" },
        "ending_type": { "type": "string" },
        "hook_end_sec": { "type": ["number", "null"] },
        "payoff_start_sec": { "type": ["number", "null"] }
      }
    },
    "layout_plan": {
      "type": "object",
      "required": ["preferred_layout", "expected_speakers", "allow_split", "allow_blur_background"],
      "properties": {
        "preferred_layout": { "enum": ["auto", "face_crop", "dual_face", "blur_background", "stacked_source", "screen_plus_face"] },
        "expected_speakers": { "type": ["integer", "null"], "minimum": 0 },
        "allow_split": { "type": "boolean" },
        "allow_blur_background": { "type": "boolean" }
      }
    },
    "caption_plan": {
      "type": "object",
      "required": ["language", "cues", "highlight_terms"],
      "properties": {
        "language": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "transcript_version": { "type": "string" },
        "alignment_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "cues": {
          "type": "array",
          "items": { "$ref": "#/definitions/caption_cue" }
        },
        "highlight_terms": { "type": "array", "items": { "type": "string" } }
      }
    },
    "caption_cue": {
      "type": "object",
      "required": ["start_sec", "end_sec", "text"],
      "properties": {
        "start_sec": { "type": "number", "minimum": 0 },
        "end_sec": { "type": "number" },
        "text": { "type": "string" },
        "speaker_id": { "type": ["string", "null"] },
        "words": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["start_sec", "end_sec", "text"],
            "properties": {
              "start_sec": { "type": "number", "minimum": 0 },
              "end_sec": { "type": "number" },
              "text": { "type": "string" }
            }
          }
        }
      }
    },
    "editing_event": {
      "type": "object",
      "required": ["time_sec", "type", "intensity"],
      "properties": {
        "time_sec": { "type": "number", "minimum": 0 },
        "type": { "enum": ["emphasis", "punchline", "important_number", "topic_label"] },
        "intensity": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
