{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aelflab.com/schemas/render-result-v2.schema.json",
  "title": "RenderResultV2",
  "type": "object",
  "required": ["contract_version", "request_id", "episode_id", "state", "clips"],
  "additionalProperties": false,
  "properties": {
    "contract_version": { "const": "2.0" },
    "request_id": { "type": "string", "minLength": 1 },
    "episode_id": { "type": "string", "minLength": 1 },
    "job_id": { "type": "string" },
    "state": { "enum": ["completed", "partial_failure", "failed", "cancelled"] },
    "error": { "type": ["string", "null"] },
    "source_video": { "type": "string" },
    "clips": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["clip_id", "status"],
        "properties": {
          "clip_id": { "type": ["string", "number"] },
          "status": { "enum": ["ok", "error"] },
          "clip_url": { "type": "string" },
          "duration_sec": { "type": "number" },
          "error": { "type": ["string", "null"] }
        }
      }
    }
  }
}