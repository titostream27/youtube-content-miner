####################################################################
# AI Podcast Producer Assistant
#
# Everything here is optional. With an empty .env the app still runs
# end to end: discovery serves a synthetic demo catalogue and scoring
# uses the deterministic heuristic engine.
#
# Copy to .env.local and fill in what you have.
####################################################################

# ------------------------------------------------------------------
# Discovery (PRD Step 1)
# ------------------------------------------------------------------
# YouTube Data API v3 key. Without it, DEMO_MODE is forced on.
# Quota note: search.list costs 100 units per call against a 10,000
# unit daily default, so a topic run with 3 expanded queries costs 300.
YOUTUBE_API_KEY=

# Force the demo catalogue even when a key is present.
DEMO_MODE=false

# Preferred caption languages, in order.
TRANSCRIPT_LANGUAGES=en,en-US,en-GB

# ------------------------------------------------------------------
# AI providers
#
# Set ONE key and every agent picks it up automatically. Ten providers
# are supported across three wire protocols - see /settings in the app
# for live status.
# ------------------------------------------------------------------
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5

GOOGLE_API_KEY=
# GOOGLE_MODEL=gemini-2.0-flash

GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

OPENROUTER_API_KEY=
# OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
TOGETHER_API_KEY=

# Local models via Ollama. Requires OLLAMA_BASE_URL to be set explicitly
# (it needs no API key, so we do not assume it is running).
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=llama3.1:8b

# Global default provider. Use `heuristic` to force the deterministic
# engine, which is useful for reproducible scoring runs.
# AI_PROVIDER=openai

# ------------------------------------------------------------------
# Per-agent routing
#
# The pipeline is five specialised agents, not one prompt. Point each
# at whichever provider suits its cost profile: query expansion is
# cheap and high volume, clip scoring is where quality is decided.
# ------------------------------------------------------------------
# AGENT_DISCOVERY_PROVIDER=groq
# AGENT_DISCOVERY_MODEL=llama-3.3-70b-versatile

# AGENT_EPISODE_TRIAGE_PROVIDER=groq
# AGENT_EPISODE_TRIAGE_MODEL=

# AGENT_MOMENT_DETECTION_PROVIDER=openai
# AGENT_MOMENT_DETECTION_MODEL=gpt-4o-mini

# AGENT_CLIP_SCORING_PROVIDER=anthropic
# AGENT_CLIP_SCORING_MODEL=claude-sonnet-4-5

# AGENT_CLIP_METADATA_PROVIDER=openai
# AGENT_CLIP_METADATA_MODEL=gpt-4o-mini

# Request tuning
AI_BATCH_SIZE=6
AI_CONCURRENCY=3
AI_TIMEOUT_MS=90000
AI_MAX_RETRIES=2

# Allow API callers to override providers per request via the `agents`
# field on POST /api/runs. Disable in a hosted deployment if the
# operator, not the caller, should decide where transcripts are sent.
AI_ALLOW_REQUEST_OVERRIDES=true

# ------------------------------------------------------------------
# Pipeline limits - the cost controls
# ------------------------------------------------------------------
# Episodes returned by discovery per run.
MAX_EPISODES_PER_RUN=12
# Episodes actually transcribed and scored per run. The real spend cap.
MAX_EPISODES_ANALYSED_PER_RUN=4
# Candidate moments scored per episode.
MAX_SCORED_SEGMENTS_PER_EPISODE=40

# PRD Step 2 gate: episodes below this are never transcribed.
EPISODE_SCORE_THRESHOLD=60
# PRD Step 7: minimum final score to enter the clip library.
CLIP_SCORE_THRESHOLD=80

# PRD Step 4: candidate moment length bounds.
SEGMENT_MIN_SEC=15
SEGMENT_MAX_SEC=90
SEGMENT_TARGET_SEC=45

# ------------------------------------------------------------------
# Transcript acquisition (PRD Step 3)
#
# Mining podcasts you do not own means YouTube's anti-bot layer is a
# real constraint. Measured behaviour from a datacenter IP:
#   - direct watch-page scrape -> HTTP 200 with a zero-byte body
#   - yt-dlp default clients   -> refused, "PO token not provided"
#   - yt-dlp player_client=android -> works, but rate limits appear
#
# So acquisition is an ordered chain. The first provider that returns a
# transcript wins; each one reports precisely why it failed, so you can
# tell "no captions exist" from "we were blocked".
#
# Run `npx tsx scripts/diagnose-transcript.ts <videoId>` to see exactly
# what happens for a given video.
# ------------------------------------------------------------------
TRANSCRIPT_PROVIDERS=ytdlp,captions
# Subtitle-only fetch ceiling (--skip-download, normally <10s). Two passes
# (manual + auto) run per episode, so worst case = 2x this value.
YTDLP_TIMEOUT_MS=30000
# Watch-page caption scrape ceiling; prevents a hung fetch from stalling a run.
CAPTIONS_TIMEOUT_MS=30000

# --- Option 1: hosted transcript vendor (recommended for cloud) ---
#
# You do NOT have to set these. The vendor and its API key can be chosen
# from the app itself, under AI Agents -> Transcript vendor, which also
# runs a connection test that verifies the response is actually usable by
# this pipeline (timestamps present, time unit correct, punctuation,
# coverage). Credentials chosen there are stored in the local database.
#
# Set them here instead when you want them pinned by the environment -
# the right choice for a shared deployment, since the UI then cannot
# change them.
#
# Use {videoUrl} or {videoId} as a placeholder; otherwise the video id is
# appended as a query parameter.
TRANSCRIPT_API_URL=
TRANSCRIPT_API_KEY=
TRANSCRIPT_API_AUTH_HEADER=x-api-key
# Set to "Bearer" if the vendor expects an Authorization header.
TRANSCRIPT_API_AUTH_SCHEME=
TRANSCRIPT_API_VIDEO_PARAM=videoId
TRANSCRIPT_API_TIMEOUT_MS=30000

# Declared, never guessed. Several vendors report offsets in ms, and
# inferring from magnitude misplaces every timecode in the first ~100
# seconds of an episode. Values: s | ms
TRANSCRIPT_API_TIME_UNIT=s

# Long videos are often answered with a job id to poll rather than a
# transcript - the normal path for full podcast episodes. {jobId} is
# substituted. Leave blank for synchronous-only vendors.
TRANSCRIPT_API_JOB_URL=
TRANSCRIPT_API_JOB_TIMEOUT_MS=180000

# --- Option 2: yt-dlp (free, needs the binary; pip install yt-dlp) ---
# Downloads only the subtitle track, never audio or video.
YTDLP_ENABLED=true
YTDLP_BINARY=yt-dlp
# Default clients are refused without a proof-of-origin token; `android`
# was measured to work from a datacenter IP. YouTube changes this.
YTDLP_PLAYER_CLIENT=android
# A residential proxy is what makes this reliable at volume.
YTDLP_PROXY=
# Cookies from a logged-in account get past "sign in to confirm".
YTDLP_COOKIES_FILE=
YTDLP_COOKIES_FROM_BROWSER=
YTDLP_EXTRA_ARGS=
YTDLP_TIMEOUT_MS=60000

# ------------------------------------------------------------------
# Speech-to-text (PRD Step 3, last resort)
#
# Important: STT does NOT solve caption blocking. Transcribing needs the
# audio, and downloading audio faces the same anti-bot layer while
# costing roughly two orders of magnitude more (dollars per episode, not
# fractions of a cent).
#
# Its real value is fidelity - specifically speaker diarization, which
# YouTube ASR does not provide. If you enable this, pick a provider that
# offers diarization rather than a plain Whisper endpoint.
#
# The audio extraction pipeline is not implemented yet; the typed seam
# reports precisely why. See src/lib/transcript/stt.ts.
# ------------------------------------------------------------------
STT_PROVIDER=
STT_API_KEY=
STT_MODEL=whisper-1

# ------------------------------------------------------------------
# Access control (self-hosted deployments)
#
# The app has no login of its own. Set both of these to require HTTP
# Basic auth on every route except /api/health, which the container
# healthcheck needs. Inert unless both are set, so local development is
# unaffected.
#
# This is defence in depth, not a replacement for keeping the port off
# the public internet - see docs/DEPLOYMENT.md section 3.
# ------------------------------------------------------------------
APP_BASIC_AUTH_USER=
APP_BASIC_AUTH_PASSWORD=

# ------------------------------------------------------------------
# Storage
#
# SQLite file. In Docker this is set to /data/content-miner.db, which is
# a mounted volume. Back it up - see scripts/backup-db.sh.
# ------------------------------------------------------------------
DATABASE_PATH=data/content-miner.db

# Timezone, used by the container and by "today" on the dashboard.
TZ=Asia/Jakarta

# ------------------------------------------------------------------
# Trending discovery (scheduled E2E runs)
#
# The scheduled pipeline pulls YouTube mostPopular videos for a region,
# derives a topic, mines it, then renders + SEOs + QCs the clips. Clips
# are left in 'awaiting_approval' and NEVER published automatically
# unless TRENDING_AUTO_APPROVAL is enabled deliberately.
# ------------------------------------------------------------------
TRENDING_REGION=ID
TRENDING_MAX_VIDEOS=25
TRENDING_MAX_TOPICS=3
TRENDING_AUTO_APPROVAL=false
# Multi-topic daily loop: process popularity-ranked topics until this many
# clips clear every gate and publish, then stop (day total may slightly exceed).
TRENDING_DAILY_CLIP_TARGET=15
# How many ranked topics the loop may fan out across in one scheduled run.
TRENDING_MAX_LOOP_TOPICS=10

# ------------------------------------------------------------------
# Prime-time publish rotation
#
# Scheduled clips are assigned a target market (US ~60% / AU ~25% /
# CH ~15%) and published via YouTube's native scheduled publish:
# uploaded private with publishAt set, then flips to public at that
# instant. Slots are local wall-clock in each market's IANA timezone
# (DST-aware). Publish still requires a human approval first.
# ------------------------------------------------------------------
PRIME_US_TZ=America/New_York
PRIME_US_HOUR=8
PRIME_US_MINUTE=0
PRIME_AU_TZ=Australia/Sydney
PRIME_AU_HOUR=19
PRIME_AU_MINUTE=0
PRIME_CH_TZ=Europe/Zurich
PRIME_CH_HOUR=7
PRIME_CH_MINUTE=0

# ------------------------------------------------------------------
# Hybrid render integration
#
# The clip library can hand each clip's [start, end] window to an
# external shorts render service (AI-Youtube-Shorts-Generator fork,
# FastAPI on port 8084) which downloads the source video once and cuts
# a vertical 9:16 short. Scoring stays here; the service only renders.
#
# RENDER_SERVICE_URL is used for server-to-server calls. Inside Docker
# the host is host.docker.internal; `npm run dev` on the same machine
# can use http://127.0.0.1:8084.
#
# RENDER_PUBLIC_URL is what the browser uses to open the rendered mp4
# (the /files/<job>/<file> endpoint). If the render service is not
# reachable by the browser, set this to its public address.
# ------------------------------------------------------------------
RENDER_SERVICE_URL=http://host.docker.internal:8084
RENDER_PUBLIC_URL=http://localhost:8084
RENDER_SERVICE_TIMEOUT_MS=900000
# RENDER_SERVICE_TOKEN=

# ==========================================================================
# Phase 1 — Clip Boundary Intelligence (Master Task Brief §38)
# ==========================================================================
# Two-pass boundary refinement context windows (seconds)
BOUNDARY_CONTEXT_BEFORE_SEC=15
BOUNDARY_CONTEXT_AFTER_SEC=20

# Next-topic guard
HIGHLIGHT_NEXT_TOPIC_LOOKAHEAD_SEC=12
HIGHLIGHT_END_GUARD_SEC=0.20
HIGHLIGHT_MAX_NEXT_TOPIC_CONTAMINATION=0.18
HIGHLIGHT_MIN_BOUNDARY_CONFIDENCE=0.82

# Duration policy (preference, not obligation)
CLIP_HARD_MIN_SEC=14
CLIP_PREFERRED_MIN_SEC=25
CLIP_PREFERRED_MAX_SEC=50
CLIP_HARD_MAX_SEC=60

# Reasoning models (e.g. 9router "deepseek" combo) spend max_tokens on hidden
# reasoning, which can empty out JSON agent output. Set "none" to disable.
AI_REASONING_EFFORT=none

# Rights/copyright gate for scheduled auto-publish (false=disabled).
SCHEDULED_REQUIRE_RIGHTS=false
